# Squad: ignore runtime state (logs, inbox, sessions)
# Note: .squad/casting/* is identity and MUST be committed to main, not ignored
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
.squad/.cache/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Java build output
target/

# Graphify: commit only the shared root graph and human-readable outputs
**/graphify-out/*
!/graphify-out/graph.json
!/graphify-out/graph.html
!/graphify-out/GRAPH_REPORT.md

.DS_Store
